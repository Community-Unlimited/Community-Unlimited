# Copy to .env and adjust. Never commit .env.

# Runtime environment ("development" | "production"). Production mode enforces
# non-default JWT secret, non-fake WhatsApp provider, strict CORS, and signed
# webhooks.
CU_ENV=development

# Database URLs.
# - Local default uses SQLite (sqlite:///./cuos.db).
# - On Neon, `neon deploy` / `neon env pull` writes DATABASE_URL (pooled) and
#   DATABASE_URL_UNPOOLED (direct) into ../.env.local, which Settings resolves
#   automatically when CU_DATABASE_URL is left at its SQLite default.
# - In Render production, set CU_DATABASE_URL (Neon pooled -pooler endpoint)
#   and CU_DIRECT_DATABASE_URL (Neon direct non-pooled endpoint for Alembic/pg_dump).
CU_DATABASE_URL=sqlite:///./cuos.db
CU_DIRECT_DATABASE_URL=

CU_JWT_SECRET=dev-only-change-me
CU_JWT_EXPIRE_MINUTES=720
CU_CORS_ORIGINS=http://localhost:5173

# Initial admin account created on container boot (required in production if
# seeding an admin user).
CU_ADMIN_EMAIL=admin@communityunlimited.sg
CU_ADMIN_PASSWORD=

# --- WhatsApp -------------------------------------------------------------
# One of: fake | oracle | cloud | twilio | waha | openwa.
# An unrecognised value is rejected at startup rather than falling back, because
# a silent fallback to "fake" in production discards every invite with no error.
#
# "fake" renders the real Cloud API request body without any network call, so
# the whole app runs offline and the /api/dev simulator stays mounted.
CU_WHATSAPP_PROVIDER=fake

# --- Oracle Cloud WhatsApp Bridge (CU_WHATSAPP_PROVIDER=oracle) -----------
CU_ORACLE_WHATSAPP_URL=https://whatsapp.rejey-services.tech
CU_ORACLE_WHATSAPP_TOKEN=
CU_ORACLE_WHATSAPP_USER_ID=

# --- Open WhatsApp / Baileys (CU_WHATSAPP_PROVIDER=openwa) ----------------
CU_OPENWA_URL=http://localhost:3000
CU_OPENWA_API_KEY=
CU_OPENWA_WEBHOOK_SECRET=

# --- Meta WhatsApp Cloud API (CU_WHATSAPP_PROVIDER=cloud) ------------------
CU_WHATSAPP_PHONE_NUMBER_ID=
CU_WHATSAPP_ACCESS_TOKEN=
CU_WHATSAPP_APP_SECRET=
CU_WHATSAPP_VERIFY_TOKEN=cu-os-verify

# --- Twilio (CU_WHATSAPP_PROVIDER=twilio) ----------------------------------
# Sends prefer the API key pair, which can be revoked on its own. The auth
# token is still required regardless: X-Twilio-Signature on inbound webhooks
# is keyed on the auth token and an API key secret will never validate it.
CU_TWILIO_ACCOUNT_SID=
CU_TWILIO_AUTH_TOKEN=
CU_TWILIO_API_KEY_SID=
CU_TWILIO_API_KEY_SECRET=

# Sandbox sender: whatsapp:+14155238886 (recipients must first send the join
# code to it). Replace with the production sender once a WhatsApp sender is
# approved on the account.
CU_TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# The exact public URL registered in the Twilio console for the inbound
# webhook. Signature validation hashes the URL Twilio *called*, so behind a
# TLS-terminating proxy a reconstructed URL arrives as http:// and never
# matches - which shows up as a 401 that looks like bad credentials. Leave
# empty to reconstruct from the X-Forwarded-* headers.
CU_TWILIO_WEBHOOK_URL=

# Optional. Public URL of POST /api/whatsapp/twilio/status. Set it to have
# Twilio report delivered/read/failed back onto the outbound row; leave empty
# and the outbox only knows that Twilio accepted the message.
CU_TWILIO_STATUS_CALLBACK_URL=

# Optional pin. Left empty, the ContentSid is looked up by template name, so a
# template re-created after a rejected approval - which mints a new SID -
# needs no config change. Manage templates with:
#   python scripts/twilio_setup.py --status
CU_TWILIO_CONTENT_SID_EVENT_INVITE=

# --- WAHA (CU_WHATSAPP_PROVIDER=waha) --------------------------------------
# Stop-gap while Meta business verification is pending. A self-hosted WAHA
# container logs in to an ordinary WhatsApp number as a linked device (the
# phone keeps working) and invites go out as polls. Against WhatsApp's terms:
# the number can be banned. Run it locally with:
#   docker run -it -p 3000:3000 -v "$PWD/.waha:/app/.sessions" \
#     -e WAHA_API_KEY=change-me -e WHATSAPP_START_SESSION=default \
#     -e WHATSAPP_HOOK_URL=http://host.docker.internal:8010/api/whatsapp/waha/webhook \
#     -e WHATSAPP_HOOK_EVENTS=poll.vote,message -e WHATSAPP_HOOK_HMAC_KEY=change-me-too \
#     devlikeapro/waha:gows
# then scan the QR code at http://localhost:3000/dashboard.
CU_WAHA_BASE_URL=http://localhost:3000
CU_WAHA_API_KEY=
CU_WAHA_SESSION=default
# Must equal WHATSAPP_HOOK_HMAC_KEY on the container. Unset, the webhook
# answers 503 rather than accepting unsigned votes.
CU_WAHA_WEBHOOK_HMAC_KEY=
# Pause between sends. Bursts to new contacts are what get a number banned.
CU_WAHA_SEND_INTERVAL_SECONDS=3
