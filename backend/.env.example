# Copy to .env and adjust. Never commit .env.

CU_DATABASE_URL=sqlite:///./cuos.db
CU_JWT_SECRET=dev-only-change-me
CU_JWT_EXPIRE_MINUTES=720
CU_CORS_ORIGINS=http://localhost:5173

# --- WhatsApp -------------------------------------------------------------
# One of: fake | cloud | twilio. An unrecognised value is rejected at startup
# rather than falling back, because a silent fallback to "fake" in production
# discards every invite with no error anywhere.
#
# "fake" renders the real Cloud API request body without any network call, so
# the whole app runs offline and the /api/dev simulator stays mounted. Both
# real providers receive that same body; Twilio translates it on the way out.
CU_WHATSAPP_PROVIDER=fake

# --- Meta WhatsApp Cloud API (CU_WHATSAPP_PROVIDER=cloud) ------------------
CU_WHATSAPP_PHONE_NUMBER_ID=
CU_WHATSAPP_ACCESS_TOKEN=
CU_WHATSAPP_APP_SECRET=
CU_WHATSAPP_VERIFY_TOKEN=cu-os-verify

# --- Twilio (CU_WHATSAPP_PROVIDER=twilio) ----------------------------------
# Sends prefer the API key pair, which can be revoked on its own. The auth
# token is still required regardless: X-Twilio-Signature on inbound webhooks
# is keyed on the auth token and an API key secret will never validate it.
CU_TWILIO_ACCOUNT_SID=
CU_TWILIO_AUTH_TOKEN=
CU_TWILIO_API_KEY_SID=
CU_TWILIO_API_KEY_SECRET=

# Sandbox sender: whatsapp:+14155238886 (recipients must first send the join
# code to it). Replace with the production sender once a WhatsApp sender is
# approved on the account.
CU_TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# The exact public URL registered in the Twilio console for the inbound
# webhook. Signature validation hashes the URL Twilio *called*, so behind a
# TLS-terminating proxy a reconstructed URL arrives as http:// and never
# matches - which shows up as a 401 that looks like bad credentials. Leave
# empty to reconstruct from the X-Forwarded-* headers.
CU_TWILIO_WEBHOOK_URL=

# Optional. Public URL of POST /api/whatsapp/twilio/status. Set it to have
# Twilio report delivered/read/failed back onto the outbound row; leave empty
# and the outbox only knows that Twilio accepted the message.
CU_TWILIO_STATUS_CALLBACK_URL=

# Optional pin. Left empty, the ContentSid is looked up by template name, so a
# template re-created after a rejected approval - which mints a new SID -
# needs no config change. Manage templates with:
#   python scripts/twilio_setup.py --status
CU_TWILIO_CONTENT_SID_EVENT_INVITE=
